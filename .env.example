# Miss Minutes Desktop Assistant - Environment Configuration Template
# Copy this file to .env and configure your values.
# Real API keys are never required for local desktop foundation / Phase 1 testing.

# AI Provider Configuration (gemini | openai | groq | huggingface)
AI_DEFAULT_PROVIDER=gemini

# Primary AI Provider: Google Gemini
# Obtain a key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
MAX_CONVERSATION_TURNS=10

# OpenAI & OpenAI-Compatible / Local Inference (Ollama, LM Studio, vLLM)
# Obtain a key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=http://localhost:11434/v1

# Groq High-Speed Inference (Optional)
# Obtain a key at: https://console.groq.com/keys
GROQ_API_KEY=

# Hugging Face Serverless Inference (Optional)
# Obtain a token at: https://huggingface.co/settings/tokens
HF_TOKEN=
HF_MODEL=meta-llama/Llama-3.3-70B-Instruct

# Application UI Settings
APP_NAME=Miss Minutes
APP_OVERLAY_OPACITY=0.98
APP_START_STATE=OFFLINE
APP_ALWAYS_ON_TOP=true

# Logging
LOG_LEVEL=INFO
